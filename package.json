{
  "name": "thomas-basadonne-tolerance-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:cloudflare": "VITE_COMMIT_REF=$WORKERS_CI_COMMIT_SHA pnpm build",
    "preview:cloudflare": "pnpm build:cloudflare && wrangler dev",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src tests scripts worker server vite.config.ts vitest.config.ts playwright.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:soak": "node scripts/soak.mjs",
    "test:visual": "node scripts/visual-review.mjs",
    "test:lookdev": "node tests/review/lookdev.mjs",
    "test:readability:zoom": "node tests/review/readability-zoom.mjs",
    "test:lighthouse": "lhci autorun --config=lighthouserc.mobile.json && lhci autorun --config=lighthouserc.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:links": "node scripts/check-links.mjs",
    "og:image": "node scripts/render-og-image.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build && pnpm check:bundle && pnpm check:links"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
