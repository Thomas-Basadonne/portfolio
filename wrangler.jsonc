// Production host: Cloudflare Workers (static assets + one API route). Workers Builds deploys
// `main` with `pnpm build:cloudflare` + `npx wrangler deploy`; see docs/HOSTING.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thomas-basadonne-portfolio",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CLIENT_ERROR_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true },
  "preview_urls": true
}
